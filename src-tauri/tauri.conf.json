{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlankRun",
  "version": "0.1.2",
  "identifier": "com.cosfoc.blankrun",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "黑着跑",
        "url": "popover.html",
        "width": 320,
        "height": 428,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "黑着跑设置",
        "url": "settings.html",
        "width": 820,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "label": "onboarding",
        "title": "黑着跑",
        "url": "onboarding.html",
        "width": 600,
        "height": 600,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RjBGRUIxQkQ1Njk4NkIKUldScm1GYTlzZjd3OWFkaklwWDhoVWdvZHpqcjBTL0F6ajd5emlCN0ZXRDNtOUR5cytJS1g0SlEK",
      "endpoints": [
        "https://github.com/hongfaqiu/blankrun/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
