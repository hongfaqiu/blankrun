{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NightBlank",
  "version": "0.1.0",
  "identifier": "com.hongfaqiu.nightblank",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "settings", "title": "NightBlank 设置", "url": "index.html",
        "width": 420, "height": 520, "resizable": false, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "compression": "lzma" }, "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
